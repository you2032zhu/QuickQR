<Window x:Class="QuickQR.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="QuickQR 设置" Width="480" Height="640" MinWidth="430" MinHeight="500" WindowStartupLocation="CenterScreen" Icon="/QuickQR;component/Resources/app.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
    <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="让 QuickQR 按你的习惯工作" Style="{StaticResource Muted}" Margin="0,8,0,24"/>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel>
      <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Theme}" AutomationProperties.Name="主题模式"/>
      <TextBlock Text="主题不会改变二维码的前景和背景颜色。" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,16,0,0"><StackPanel>
      <TextBlock Text="启动与托盘" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding StartupModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding StartupMode}" AutomationProperties.Name="启动模式"/>
      <CheckBox Content="登录 Windows 时启动" IsChecked="{Binding StartAtLogin}" Margin="0,18,0,10"/>
      <CheckBox Content="打开托盘面板时自动粘贴剪贴板文本" IsChecked="{Binding AutoPaste}"/>
      <TextBlock Text="仅在打开面板时读取一次，不持续监控剪贴板。关闭主窗口后，仍可从系统托盘使用 QuickQR。" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
    <TextBlock Text="设置自动保存 · 输入内容不保存" Style="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
    <TextBlock Text="QuickQR for Windows  1.0.0" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
  </StackPanel></ScrollViewer>
</Window>
