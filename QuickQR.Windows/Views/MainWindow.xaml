<Window x:Class="QuickQR.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuickQR.Views"
        Style="{StaticResource {x:Type Window}}" Title="QuickQR for Windows" Width="860" Height="580" MinWidth="800" MinHeight="520" WindowStartupLocation="CenterScreen" Icon="/QuickQR;component/Resources/app.ico">
  <Window.InputBindings><KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyCommand}"/><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/></Window.InputBindings>
  <Grid Margin="28,20,28,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <StackPanel><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource AccentFillBrush}" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0"><TextBlock Text="▦" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="QuickQR" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
        <TextBlock Text="输入文本，即时生成二维码" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
      <Button Content="⚙  设置" Click="Settings_Click" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="设置"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="324"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,9"><TextBlock Text="内容" FontWeight="SemiBold"/><TextBlock Text="{Binding CharacterCount}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,18">
          <TextBox x:Name="InputBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False" AutomationProperties.Name="二维码内容"/>
          <TextBlock Text="输入文本或粘贴链接..." Margin="15" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <StackPanel Grid.Row="2">
          <UniformGrid Columns="2" Margin="0,0,0,12">
            <StackPanel Margin="0,0,6,0"><TextBlock Text="前景颜色" Style="{StaticResource Label}"/><Button Command="{Binding ForegroundCommand}" Padding="10,8" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" Background="{Binding ForegroundBrush}" BorderBrush="#A0A0A0" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0"/><TextBlock Text="{Binding Foreground}"/></StackPanel></Button></StackPanel>
            <StackPanel Margin="6,0,0,0"><TextBlock Text="背景颜色" Style="{StaticResource Label}"/><Button Command="{Binding BackgroundCommand}" Padding="10,8" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" Background="{Binding BackgroundBrush}" BorderBrush="#A0A0A0" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0"/><TextBlock Text="{Binding Background}"/></StackPanel></Button></StackPanel>
          </UniformGrid>
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,6,0"><TextBlock Text="纠错等级" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding CorrectionLevels}" SelectedItem="{Binding Correction}" AutomationProperties.Name="纠错等级" ToolTip="L 7% · M 15% · Q 25% · H 30%"/></StackPanel>
            <StackPanel Margin="6,0,0,0"><TextBlock Text="导出分辨率 · px" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ExportSizes}" SelectedItem="{Binding ExportSize}" AutomationProperties.Name="导出分辨率"/></StackPanel>
          </UniformGrid>
          <Button Content="清空内容" Command="{Binding ClearCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-8,6,0,0"/>
        </StackPanel>
      </Grid>
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="实时预览" FontWeight="SemiBold"/><TextBlock Text="PNG" Style="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="11"/></DockPanel>
          <Grid Grid.Row="1" Margin="0,12">
            <Grid><local:QRPreview Document="{Binding Document}"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasCode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="▦" Foreground="#BEC8DA" FontSize="56" HorizontalAlignment="Center"/><TextBlock Text="在左侧输入，二维码即刻出现" Foreground="#768299" FontSize="12" Margin="0,12,0,0"/></StackPanel></Grid>
          </Grid>
          <UniformGrid Grid.Row="2" Columns="2"><Button Content="复制二维码" Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" ToolTip="Ctrl+Shift+C"/><Button Content="保存图片" Command="{Binding SaveCommand}" Margin="5,0,0,0" ToolTip="Ctrl+S"/></UniformGrid>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,3,12,0"/></StackPanel><TextBlock Grid.Column="1" Text="●  完全离线" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Top"/></Grid>
  </Grid>
</Window>
